#!/usr/bin/env bash
set -Eeuo pipefail

VERSION=1.1.0
REPO=MetaCubeX/mihomo
BIN=/usr/local/bin/mihomo
SERVICE=/etc/systemd/system/mihomo.service
STATE=/etc/mhm.conf
CONFIG_DIR=/etc/mihomo
MIXED_PORT=7890
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=9090
SECRET=
GITHUB_PROXY=
CONFIG_FILE=
TMP=

if [[ -t 1 ]]; then R='\033[0m'; RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; CYAN='\033[36m'; else R=; RED=; GREEN=; YELLOW=; BLUE=; CYAN=; fi
info(){ printf '%b[信息]%b %s\n' "$BLUE" "$R" "$*"; }
ok(){ printf '%b[完成]%b %s\n' "$GREEN" "$R" "$*"; }
warn(){ printf '%b[注意]%b %s\n' "$YELLOW" "$R" "$*"; }
die(){ printf '%b[错误]%b %s\n' "$RED" "$R" "$*" >&2; exit 1; }
trap '[[ -n ${TMP:-} && -d ${TMP:-} ]] && rm -rf "$TMP"' EXIT
root(){ [[ ${EUID:-$(id -u)} -eq 0 ]] || die '请使用 root 或 sudo 运行。'; }
systemd(){ command -v systemctl >/dev/null || die '仅支持 systemd Linux。'; }
read_tty(){ local n=$1 p=$2 s=${3:-0} v=; [[ -r /dev/tty ]] || die '当前环境无法交互输入。'; if [[ $s == 1 ]]; then IFS= read -r -s -p "$p" v </dev/tty || true; printf '\n' >/dev/tty; else IFS= read -r -p "$p" v </dev/tty || true; fi; printf -v "$n" '%s' "$v"; }
confirm(){ local a=; read_tty a "$1 [y/N] "; [[ $a =~ ^[Yy]$ ]]; }
port_ok(){ [[ $1 =~ ^[0-9]+$ ]] && ((10#$1>=1 && 10#$1<=65535)); }
dir_ok(){ [[ $1 =~ ^/[A-Za-z0-9._/-]+$ ]] && [[ $1 != *'/../'* && $1 != */.. ]]; }
proxy_ok(){ [[ -z $1 || $1 =~ ^https?://[^[:space:]]+$ ]]; }

load_state(){ CONFIG_DIR=/etc/mihomo; MIXED_PORT=7890; CONTROLLER_HOST=0.0.0.0; CONTROLLER_PORT=9090; SECRET=; GITHUB_PROXY=; [[ -f $STATE ]] && source "$STATE"; CONFIG_FILE=${CONFIG_DIR%/}/config.yaml; }
save_state(){ umask 077; { printf 'CONFIG_DIR=%q\n' "$CONFIG_DIR"; printf 'MIXED_PORT=%q\n' "$MIXED_PORT"; printf 'CONTROLLER_HOST=%q\n' "$CONTROLLER_HOST"; printf 'CONTROLLER_PORT=%q\n' "$CONTROLLER_PORT"; printf 'SECRET=%q\n' "$SECRET"; printf 'GITHUB_PROXY=%q\n' "$GITHUB_PROXY"; } > "$STATE"; chmod 600 "$STATE"; }

deps(){
  local p=(); command -v curl >/dev/null || p+=(curl ca-certificates); command -v gzip >/dev/null || p+=(gzip); ((${#p[@]}==0)) && return
  if command -v apt-get >/dev/null; then apt-get update -y; DEBIAN_FRONTEND=noninteractive apt-get install -y "${p[@]}"
  elif command -v dnf >/dev/null; then dnf install -y "${p[@]}"
  elif command -v yum >/dev/null; then yum install -y "${p[@]}"
  elif command -v apk >/dev/null; then apk add --no-cache "${p[@]}"
  elif command -v pacman >/dev/null; then pacman -Sy --noconfirm "${p[@]}"
  else die "请先安装：${p[*]}"; fi
}
arch(){ case $(uname -m) in x86_64|amd64) echo amd64-compatible;; aarch64|arm64) echo arm64;; armv7l|armv7) echo armv7;; i386|i486|i586|i686) echo 386;; riscv64) echo riscv64;; s390x) echo s390x;; loongarch64) echo loong64-abi2;; *) die "不支持的架构：$(uname -m)";; esac; }
effective_proxy(){ printf '%s' "${MIHOMO_GITHUB_PROXY:-$GITHUB_PROXY}"; }
proxy_url(){ local p; p=$(effective_proxy); [[ -n $p ]] && printf '%s/%s' "${p%/}" "$1" || printf '%s' "$1"; }
latest(){
  if [[ -n ${MIHOMO_VERSION:-} ]]; then [[ $MIHOMO_VERSION == v* ]] && echo "$MIHOMO_VERSION" || echo "v$MIHOMO_VERSION"; return; fi
  local api=https://api.github.com/repos/$REPO/releases/latest json= p=; json=$(curl -fsSL --retry 3 -A "mhm/$VERSION" "$api" 2>/dev/null || true)
  if [[ -z $json ]]; then p=$(effective_proxy); [[ -n $p ]] && json=$(curl -fsSL --retry 3 -A "mhm/$VERSION" "${p%/}/$api" 2>/dev/null || true); fi
  printf '%s' "$json" | sed -nE 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n1
}
download(){
  deps; TMP=$(mktemp -d); local a t n u; a=$(arch); t=$(latest); [[ $t =~ ^v[0-9] ]] || die '无法获取 Mihomo 版本。可使用 MIHOMO_VERSION 指定版本。'; n=mihomo-linux-$a-$t.gz; u=$(proxy_url "https://github.com/$REPO/releases/download/$t/$n")
  info "下载 $n"; curl -fL --retry 3 --connect-timeout 20 -A "mhm/$VERSION" "$u" -o "$TMP/mihomo.gz"; gzip -t "$TMP/mihomo.gz"; gzip -dc "$TMP/mihomo.gz" > "$TMP/mihomo"; chmod +x "$TMP/mihomo"; "$TMP/mihomo" -v >/dev/null || die '二进制无法运行。'
}
secret_gen(){ command -v openssl >/dev/null && openssl rand -hex 16 || od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
yaml_q(){ printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }
yaml_set(){ local f=$1 k=$2 v=$3 t; t=$(mktemp); awk -v k="$k" -v r="$k: $v" 'BEGIN{x=0}!x&&substr($0,1,length(k)+1)==k":"{print r;x=1;next}{print}END{if(!x)print r}' "$f" > "$t"; cat "$t" > "$f"; rm -f "$t"; }

prompt_proxy(){
  local v= current=${GITHUB_PROXY:-未设置}; read_tty v "GitHub 下载代理 [$current]（输入 none 清除）："
  case $v in '') ;; none|NONE|off|OFF|clear|CLEAR|-) GITHUB_PROXY=;; *) proxy_ok "$v" || die '代理必须以 http:// 或 https:// 开头。'; GITHUB_PROXY=${v%/};; esac
  [[ -n $GITHUB_PROXY ]] && info "GitHub 下载代理：$GITHUB_PROXY" || info 'GitHub 下载方式：直连'
}
prompt_settings(){
  local v= old=$CONFIG_FILE
  read_tty v "配置目录 [$CONFIG_DIR]："; [[ -n $v ]] && CONFIG_DIR=$v; dir_ok "$CONFIG_DIR" || die '配置目录无效。'
  read_tty v "Mixed 端口 [$MIXED_PORT]："; [[ -n $v ]] && MIXED_PORT=$v; port_ok "$MIXED_PORT" || die 'Mixed 端口无效。'
  read_tty v "控制 API 地址 [$CONTROLLER_HOST]："; [[ -n $v ]] && CONTROLLER_HOST=$v
  read_tty v "控制 API 端口 [$CONTROLLER_PORT]："; [[ -n $v ]] && CONTROLLER_PORT=$v; port_ok "$CONTROLLER_PORT" || die '控制端口无效。'
  read_tty v 'API Secret（留空则保留或生成）：' 1; [[ -n $v ]] && SECRET=$v; [[ -n $SECRET ]] || SECRET=$(secret_gen)
  CONFIG_FILE=${CONFIG_DIR%/}/config.yaml; mkdir -p "$CONFIG_DIR"; chmod 700 "$CONFIG_DIR" || true
  [[ ! -f $CONFIG_FILE && -f $old && $old != "$CONFIG_FILE" ]] && cp -a "$old" "$CONFIG_FILE"
  if [[ -f $CONFIG_FILE ]]; then
    cp -a "$CONFIG_FILE" "$CONFIG_FILE.bak.$(date +%Y%m%d-%H%M%S)"
    yaml_set "$CONFIG_FILE" mixed-port "$MIXED_PORT"; yaml_set "$CONFIG_FILE" external-controller "$(yaml_q "$CONTROLLER_HOST:$CONTROLLER_PORT")"; yaml_set "$CONFIG_FILE" secret "$(yaml_q "$SECRET")"
    grep -q '^external-controller-cors:' "$CONFIG_FILE" || printf "\nexternal-controller-cors:\n  allow-origins:\n    - '*'\n  allow-private-network: true\n" >> "$CONFIG_FILE"
  else
    cat > "$CONFIG_FILE" <<CFG
mixed-port: $MIXED_PORT
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
ipv6: true
external-controller: $(yaml_q "$CONTROLLER_HOST:$CONTROLLER_PORT")
secret: $(yaml_q "$SECRET")
external-controller-cors:
  allow-origins:
    - '*'
  allow-private-network: true
proxies: []
proxy-groups: []
rules:
  - MATCH,DIRECT
CFG
  fi
  chmod 600 "$CONFIG_FILE"
}

test_cfg(){ "$1" -t -d "$CONFIG_DIR" -f "$CONFIG_FILE"; }
write_service(){ cat > "$SERVICE" <<UNIT
[Unit]
Description=Mihomo Proxy Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$CONFIG_DIR
ExecStart=$BIN -d $CONFIG_DIR -f $CONFIG_FILE
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
UMask=0027

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload; }
show(){ local ip=服务器IP h=$CONTROLLER_HOST; command -v hostname >/dev/null && ip=$(hostname -I 2>/dev/null | awk '{print $1}'); [[ -n $ip ]] || ip=服务器IP; [[ $h == 0.0.0.0 || $h == '[::]' ]] && h=$ip; printf '\n配置文件：%s\nMixed 代理：%s:%s\n控制 API：http://%s:%s\nAPI Secret：%s\nGitHub 下载代理：%s\n' "$CONFIG_FILE" "$ip" "$MIXED_PORT" "$h" "$CONTROLLER_PORT" "$SECRET" "${GITHUB_PROXY:-未设置（直连）}"; }

install_action(){
  root; systemd; load_state; prompt_proxy; save_state; download; prompt_settings; test_cfg "$TMP/mihomo" || die '配置检查失败。'; local rb=; [[ -x $BIN ]] && rb=$BIN.rollback && cp -a "$BIN" "$rb"; install -m 0755 "$TMP/mihomo" "$BIN"; write_service; systemctl enable mihomo >/dev/null
  if systemctl restart mihomo && sleep 1 && systemctl is-active --quiet mihomo; then rm -f "$rb"; save_state; ok 'Mihomo 已安装并设置为开机自启。'; show; else [[ -n $rb ]] && mv -f "$rb" "$BIN"; systemctl restart mihomo >/dev/null 2>&1 || true; die '启动失败，已尝试回滚。'; fi
}
upgrade_action(){ root; systemd; load_state; [[ -x $BIN ]] || die '尚未安装。'; download; test_cfg "$TMP/mihomo" || die '新版本不兼容当前配置。'; cp -a "$BIN" "$BIN.rollback"; install -m 0755 "$TMP/mihomo" "$BIN"; if systemctl restart mihomo && sleep 1 && systemctl is-active --quiet mihomo; then rm -f "$BIN.rollback"; ok '升级完成。'; else mv -f "$BIN.rollback" "$BIN"; systemctl restart mihomo || true; die '升级失败，已回滚。'; fi; }
proxy_action(){ root; load_state; prompt_proxy; save_state; ok 'GitHub 下载代理设置已保存。'; }
configure_action(){ root; systemd; load_state; [[ -x $BIN ]] || die '尚未安装。'; prompt_proxy; prompt_settings; test_cfg "$BIN" || die '配置检查失败，请从备份恢复。'; write_service; systemctl enable mihomo >/dev/null; systemctl restart mihomo; save_state; ok '设置已更新。'; show; }
uninstall_action(){ root; systemd; load_state; local yes=0 purge=0; shift || true; while (($#)); do case $1 in -y|--yes) yes=1;; --purge) purge=1;; *) die "未知参数：$1";; esac; shift; done; ((yes)) || confirm '确定卸载 Mihomo 吗？' || return; systemctl disable --now mihomo >/dev/null 2>&1 || true; rm -f "$SERVICE" "$BIN" "$STATE"; systemctl daemon-reload; if ((purge)); then case $CONFIG_DIR in /|/etc|/usr|/var|/home|/root|/opt|/srv) warn "拒绝删除危险目录：$CONFIG_DIR";; *) rm -rf -- "$CONFIG_DIR";; esac; fi; ok 'Mihomo 已卸载。'; }

help(){ cat <<HELP
mhm v$VERSION - Mihomo Linux 管理脚本

sudo mhm                     互动菜单
sudo mhm install             安装或重新安装
sudo mhm upgrade             升级 Mihomo
sudo mhm configure           修改全部设置
sudo mhm proxy               设置或清除 GitHub 下载代理
sudo mhm start|stop|restart
sudo mhm status              查看状态
sudo mhm logs                查看实时日志
sudo mhm test                检查配置
sudo mhm uninstall [--yes] [--purge]

环境变量：MIHOMO_VERSION=v1.19.29
            MIHOMO_GITHUB_PROXY=https://example.com（临时覆盖持久设置）
HELP
}
menu(){ while true; do printf '\n%bmhm v%s%b\n1. 安装/重装\n2. 升级\n3. 修改全部设置\n4. 设置 GitHub 下载代理\n5. 启动\n6. 停止\n7. 重启\n8. 状态\n9. 日志\n10. 检查配置\n11. 卸载\n0. 退出\n' "$CYAN" "$VERSION" "$R"; local n=; read_tty n '请选择 [0-11]：'; case $n in 1) install_action;; 2) upgrade_action;; 3) configure_action;; 4) proxy_action;; 5) root; systemctl start mihomo;; 6) root; systemctl stop mihomo;; 7) root; systemctl restart mihomo;; 8) load_state; "$BIN" -v 2>/dev/null || true; systemctl status mihomo --no-pager || true; show;; 9) journalctl -u mihomo -n100 -f;; 10) load_state; test_cfg "$BIN";; 11) uninstall_action uninstall;; 0) exit;; *) warn '无效选项。';; esac; done; }

cmd=${1:-menu}
case $cmd in
  menu) menu;; install) install_action;; upgrade|update) upgrade_action;; configure|config) configure_action;; proxy|github-proxy) proxy_action;;
  start|stop|restart) root; systemd; systemctl "$cmd" mihomo;;
  status) load_state; "$BIN" -v 2>/dev/null || true; systemctl status mihomo --no-pager || true; [[ -f $STATE ]] && show;;
  logs|log) journalctl -u mihomo -n100 -f;; test|check) load_state; test_cfg "$BIN";;
  uninstall|remove) uninstall_action "$@";; -h|--help|help) help;; -v|--version|version) echo "mhm $VERSION";;
  *) die "未知命令：$cmd";;
esac
