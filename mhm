#!/usr/bin/env bash
set -Eeuo pipefail

VERSION=1.2.2
REPO=MetaCubeX/mihomo
BIN=/usr/local/bin/mihomo
SERVICE=/etc/systemd/system/mihomo.service
STATE=/etc/mhm.conf
CONFIG_DIR=/etc/mihomo
MIXED_PORT=7890
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=9090
SECRET=
GITHUB_MIRROR=
DOWNLOAD_PROXY=
CONFIG_FILE=
TMP=
SERVICE_STATE=
HEALTH_MIXED_STATUS=
HEALTH_MIXED_OWNER=
HEALTH_CONTROLLER_STATUS=
HEALTH_CONTROLLER_OWNER=
HEALTH_LOG_ERROR=
PORT_STATUS=
PORT_OWNER=

if [[ -t 1 ]]; then R='\033[0m'; RED='\033[31m'; GREEN='\033[32m'; YELLOW='\033[33m'; BLUE='\033[34m'; CYAN='\033[36m'; else R=; RED=; GREEN=; YELLOW=; BLUE=; CYAN=; fi
info(){ printf '%b[信息]%b %s\n' "$BLUE" "$R" "$*"; }
ok(){ printf '%b[完成]%b %s\n' "$GREEN" "$R" "$*"; }
warn(){ printf '%b[注意]%b %s\n' "$YELLOW" "$R" "$*"; }
die(){ printf '%b[错误]%b %s\n' "$RED" "$R" "$*" >&2; exit 1; }
trap '[[ -n ${TMP:-} && -d ${TMP:-} ]] && rm -rf "$TMP"' EXIT
root(){ [[ ${EUID:-$(id -u)} -eq 0 ]] || die '请使用 root 或 sudo 运行。'; }
systemd(){ command -v systemctl >/dev/null || die '仅支持 systemd Linux。'; }
read_tty(){
  local __mhm_target=$1 __mhm_prompt=$2 __mhm_secret=${3:-0} __mhm_value=
  [[ -r /dev/tty ]] || die '当前环境无法交互输入。'
  if [[ $__mhm_secret == 1 ]]; then
    IFS= read -r -s -p "$__mhm_prompt" __mhm_value </dev/tty || true
    printf '\n' >/dev/tty
  else
    IFS= read -r -p "$__mhm_prompt" __mhm_value </dev/tty || true
  fi
  printf -v "$__mhm_target" '%s' "$__mhm_value"
}
confirm(){ local answer=; read_tty answer "$1 [y/N] "; [[ $answer =~ ^[Yy]$ ]]; }
port_ok(){ [[ $1 =~ ^[0-9]+$ ]] && ((10#$1>=1 && 10#$1<=65535)); }
dir_ok(){ [[ $1 =~ ^/[A-Za-z0-9._/-]+$ ]] && [[ $1 != *'/../'* && $1 != */.. ]]; }
mirror_ok(){ [[ $1 =~ ^https?://[^[:space:]]+$ ]]; }
transport_proxy_ok(){ [[ $1 =~ ^(https?|socks|socks4|socks4a|socks5|socks5h)://[^[:space:]]+$ ]]; }

load_state(){
  CONFIG_DIR=/etc/mihomo; MIXED_PORT=7890; CONTROLLER_HOST=0.0.0.0; CONTROLLER_PORT=9090; SECRET=; GITHUB_MIRROR=; DOWNLOAD_PROXY=; GITHUB_PROXY=
  [[ -f $STATE ]] && source "$STATE"
  if [[ -n ${GITHUB_PROXY:-} && -z $GITHUB_MIRROR && -z $DOWNLOAD_PROXY ]]; then GITHUB_MIRROR=$GITHUB_PROXY; fi
  CONFIG_FILE=${CONFIG_DIR%/}/config.yaml
}
save_state(){
  umask 077
  {
    printf 'CONFIG_DIR=%q\n' "$CONFIG_DIR"
    printf 'MIXED_PORT=%q\n' "$MIXED_PORT"
    printf 'CONTROLLER_HOST=%q\n' "$CONTROLLER_HOST"
    printf 'CONTROLLER_PORT=%q\n' "$CONTROLLER_PORT"
    printf 'SECRET=%q\n' "$SECRET"
    printf 'GITHUB_MIRROR=%q\n' "$GITHUB_MIRROR"
    printf 'DOWNLOAD_PROXY=%q\n' "$DOWNLOAD_PROXY"
  } > "$STATE"
  chmod 600 "$STATE"
}

deps(){
  local packages=()
  command -v curl >/dev/null || packages+=(curl ca-certificates)
  command -v gzip >/dev/null || packages+=(gzip)
  ((${#packages[@]}==0)) && return
  if command -v apt-get >/dev/null; then apt-get update -y; DEBIAN_FRONTEND=noninteractive apt-get install -y "${packages[@]}"
  elif command -v dnf >/dev/null; then dnf install -y "${packages[@]}"
  elif command -v yum >/dev/null; then yum install -y "${packages[@]}"
  elif command -v apk >/dev/null; then apk add --no-cache "${packages[@]}"
  elif command -v pacman >/dev/null; then pacman -Sy --noconfirm "${packages[@]}"
  else die "请先安装：${packages[*]}"; fi
}
arch(){ case $(uname -m) in x86_64|amd64) echo amd64-compatible;; aarch64|arm64) echo arm64;; armv7l|armv7) echo armv7;; i386|i486|i586|i686) echo 386;; riscv64) echo riscv64;; s390x) echo s390x;; loongarch64) echo loong64-abi2;; *) die "不支持的架构：$(uname -m)";; esac; }

effective_mirror(){
  if [[ -n ${MIHOMO_GITHUB_MIRROR:-} ]]; then printf '%s' "$MIHOMO_GITHUB_MIRROR"
  elif [[ -n ${MIHOMO_GITHUB_PROXY:-} && ! ${MIHOMO_GITHUB_PROXY} =~ ^(socks|socks4|socks4a|socks5|socks5h):// ]]; then printf '%s' "$MIHOMO_GITHUB_PROXY"
  else printf '%s' "$GITHUB_MIRROR"
  fi
}
effective_transport_proxy(){
  if [[ -n ${MIHOMO_DOWNLOAD_PROXY:-} ]]; then printf '%s' "$MIHOMO_DOWNLOAD_PROXY"
  elif [[ -n ${MIHOMO_GITHUB_PROXY:-} && ${MIHOMO_GITHUB_PROXY} =~ ^(socks|socks4|socks4a|socks5|socks5h):// ]]; then printf '%s' "$MIHOMO_GITHUB_PROXY"
  else printf '%s' "$DOWNLOAD_PROXY"
  fi
}
mirror_url(){ local mirror; mirror=$(effective_mirror); [[ -n $mirror ]] && printf '%s/%s' "${mirror%/}" "$1" || printf '%s' "$1"; }
curl_get(){
  local url=$1 output=${2:-} proxy
  proxy=$(effective_transport_proxy)
  local args=(-fL --retry 3 --connect-timeout 20 -A "mhm/$VERSION")
  [[ -n $proxy ]] && args+=(--proxy "$proxy")
  [[ -n $output ]] && args+=(-o "$output")
  curl "${args[@]}" "$url"
}
latest(){
  if [[ -n ${MIHOMO_VERSION:-} ]]; then [[ $MIHOMO_VERSION == v* ]] && echo "$MIHOMO_VERSION" || echo "v$MIHOMO_VERSION"; return; fi
  local api=https://api.github.com/repos/$REPO/releases/latest json= mirror=
  json=$(curl_get "$api" 2>/dev/null || true)
  if [[ -z $json ]]; then mirror=$(effective_mirror); [[ -n $mirror ]] && json=$(curl_get "${mirror%/}/$api" 2>/dev/null || true); fi
  printf '%s' "$json" | sed -nE 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/p' | head -n1
}
download(){
  deps
  TMP=$(mktemp -d)
  local architecture tag filename url
  architecture=$(arch)
  tag=$(latest)
  [[ $tag =~ ^v[0-9] ]] || die '无法获取 Mihomo 版本。可使用 MIHOMO_VERSION 指定版本。'
  filename=mihomo-linux-$architecture-$tag.gz
  url=$(mirror_url "https://github.com/$REPO/releases/download/$tag/$filename")
  info "下载 $filename"
  curl_get "$url" "$TMP/mihomo.gz"
  gzip -t "$TMP/mihomo.gz"
  gzip -dc "$TMP/mihomo.gz" > "$TMP/mihomo"
  chmod +x "$TMP/mihomo"
  "$TMP/mihomo" -v >/dev/null || die '二进制无法运行。'
}
secret_gen(){ command -v openssl >/dev/null && openssl rand -hex 16 || od -An -N16 -tx1 /dev/urandom | tr -d ' \n'; }
yaml_q(){ printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"; }
yaml_set(){ local file=$1 key=$2 value=$3 temporary; temporary=$(mktemp); awk -v k="$key" -v r="$key: $value" 'BEGIN{x=0}!x&&substr($0,1,length(k)+1)==k":"{print r;x=1;next}{print}END{if(!x)print r}' "$file" > "$temporary"; cat "$temporary" > "$file"; rm -f "$temporary"; }

show_download(){
  if [[ -n $DOWNLOAD_PROXY ]]; then printf '网络代理：%s' "$DOWNLOAD_PROXY"
  elif [[ -n $GITHUB_MIRROR ]]; then printf '镜像前缀：%s' "$GITHUB_MIRROR"
  else printf '直连 GitHub'
  fi
}
current_invocation_logs(){
  local invocation start
  invocation=$(systemctl show mihomo -p InvocationID --value 2>/dev/null || true)
  if [[ -n $invocation ]]; then
    journalctl "_SYSTEMD_INVOCATION_ID=$invocation" --no-pager -o cat 2>/dev/null || true
    return
  fi
  start=$(systemctl show mihomo -p ActiveEnterTimestamp --value 2>/dev/null || true)
  if [[ -n $start ]]; then journalctl -u mihomo --since "$start" --no-pager -o cat 2>/dev/null || true
  else journalctl -u mihomo -n 100 --no-pager -o cat 2>/dev/null || true
  fi
}
check_port(){
  local port=$1 pid=$2 lines owner=
  PORT_STATUS=unknown
  PORT_OWNER=
  command -v ss >/dev/null 2>&1 || return 0
  lines=$(ss -H -ltnp "sport = :$port" 2>/dev/null || true)
  if [[ -z $lines ]]; then PORT_STATUS=missing; return 0; fi
  if [[ $pid =~ ^[1-9][0-9]*$ ]] && grep -Fq "pid=$pid," <<<"$lines"; then PORT_STATUS=owned; return 0; fi
  if grep -q 'pid=' <<<"$lines"; then
    PORT_STATUS=other
    owner=$(printf '%s\n' "$lines" | sed -nE 's/.*users:\(\("([^"]+)",pid=([0-9]+).*/\1 (PID \2)/p' | head -n1)
    PORT_OWNER=${owner:-其他进程}
  else
    PORT_STATUS=listening
  fi
}
evaluate_service(){
  local has_binary=0 has_service=0 pid=0 logs=
  SERVICE_STATE=not-installed
  HEALTH_MIXED_STATUS=unknown; HEALTH_MIXED_OWNER=
  HEALTH_CONTROLLER_STATUS=unknown; HEALTH_CONTROLLER_OWNER=
  HEALTH_LOG_ERROR=
  [[ -x $BIN ]] && has_binary=1
  [[ -f $SERVICE ]] && has_service=1
  if ((has_binary==0 && has_service==0)); then return
  elif ((has_binary==1 && has_service==0)); then SERVICE_STATE=binary-only; return
  elif ((has_binary==0 && has_service==1)); then SERVICE_STATE=broken; return
  fi
  if ! command -v systemctl >/dev/null 2>&1 || ! systemctl is-active --quiet mihomo 2>/dev/null; then SERVICE_STATE=stopped; return; fi
  SERVICE_STATE=running
  pid=$(systemctl show mihomo -p MainPID --value 2>/dev/null || printf '0')
  check_port "$MIXED_PORT" "$pid"; HEALTH_MIXED_STATUS=$PORT_STATUS; HEALTH_MIXED_OWNER=$PORT_OWNER
  check_port "$CONTROLLER_PORT" "$pid"; HEALTH_CONTROLLER_STATUS=$PORT_STATUS; HEALTH_CONTROLLER_OWNER=$PORT_OWNER
  logs=$(current_invocation_logs)
  HEALTH_LOG_ERROR=$(printf '%s\n' "$logs" | grep -Ei -m1 'Start .* server error|RESTful API.*(error|failed)|address already in use|bind: permission denied|failed to listen|listen (tcp|udp).*(failed|error)' || true)
  if [[ -n $HEALTH_LOG_ERROR || $HEALTH_MIXED_STATUS == missing || $HEALTH_MIXED_STATUS == other || $HEALTH_CONTROLLER_STATUS == missing || $HEALTH_CONTROLLER_STATUS == other ]]; then SERVICE_STATE=degraded; fi
}
state_text(){
  case $1 in
    not-installed) printf '未安装';;
    running) printf '运行中';;
    degraded) printf '运行异常';;
    stopped) printf '已安装，未运行';;
    binary-only) printf '已安装，systemd 服务未注册';;
    broken) printf 'systemd 服务已注册，但 Mihomo 二进制缺失';;
  esac
}
port_text(){
  case $1 in
    owned) printf '正常';;
    listening) printf '已监听，但无法确认所属进程';;
    missing) printf '异常：未监听';;
    other) printf '异常：被 %s 占用' "${2:-其他进程}";;
    unknown) printf '未检查（系统缺少 ss 或权限不足）';;
  esac
}
mihomo_version(){ local version=; [[ -x $BIN ]] && version=$("$BIN" -v 2>/dev/null | sed -n '1p' || true); printf '%s' "${version:-未知}"; }
autostart_text(){ if [[ ! -f $SERVICE ]]; then printf '未注册'; elif command -v systemctl >/dev/null 2>&1 && systemctl is-enabled --quiet mihomo 2>/dev/null; then printf '已启用'; else printf '未启用'; fi; }
show_summary(){
  load_state
  evaluate_service
  local status version autostart secret_status
  status=$(state_text "$SERVICE_STATE")
  if [[ $SERVICE_STATE == degraded ]]; then printf '\n%b状态：%s%b\n' "$RED" "$status" "$R"; else printf '\n状态：%s\n' "$status"; fi
  [[ $SERVICE_STATE == not-installed ]] && return
  version=$(mihomo_version)
  autostart=$(autostart_text)
  [[ -n $SECRET ]] && secret_status=已设置 || secret_status=未设置
  printf 'Mihomo 版本：%s\n' "$version"
  printf '配置目录：%s\n' "$CONFIG_DIR"
  printf '配置文件：%s\n' "$CONFIG_FILE"
  printf 'Mixed 端口：%s（' "$MIXED_PORT"; port_text "$HEALTH_MIXED_STATUS" "$HEALTH_MIXED_OWNER"; printf '）\n'
  printf '控制 API：%s:%s（' "$CONTROLLER_HOST" "$CONTROLLER_PORT"; port_text "$HEALTH_CONTROLLER_STATUS" "$HEALTH_CONTROLLER_OWNER"; printf '）\n'
  printf 'API Secret：%s\n' "$secret_status"
  printf '开机自启：%s\n' "$autostart"
  printf 'GitHub 下载方式：'; show_download; printf '\n'
  if [[ -n $HEALTH_LOG_ERROR ]]; then printf '%b启动错误：%s%b\n' "$RED" "$HEALTH_LOG_ERROR" "$R"; fi
}
prompt_download(){
  local choice= value=
  printf '\n当前 GitHub 下载方式：'; show_download; printf '\n1. 直连 GitHub\n2. GitHub 镜像前缀（如 https://ghproxy.com）\n3. HTTP/SOCKS 网络代理（如 socks5h://127.0.0.1:12222）\n0. 保持不变\n'
  read_tty choice '请选择 [0-3]：'
  case $choice in
    0|'') ;;
    1) GITHUB_MIRROR=; DOWNLOAD_PROXY=;;
    2) read_tty value '镜像前缀：'; mirror_ok "$value" || die '镜像前缀必须以 http:// 或 https:// 开头。'; GITHUB_MIRROR=${value%/}; DOWNLOAD_PROXY=;;
    3) read_tty value '代理地址：'; transport_proxy_ok "$value" || die '支持 http、https、socks、socks4、socks4a、socks5、socks5h。'; DOWNLOAD_PROXY=$value; GITHUB_MIRROR=;;
    *) die '无效选项。';;
  esac
  printf '已选择：'; show_download; printf '\n'
}
prompt_settings(){
  local value= old_config=$CONFIG_FILE
  read_tty value "配置目录 [$CONFIG_DIR]："; [[ -n $value ]] && CONFIG_DIR=$value; dir_ok "$CONFIG_DIR" || die '配置目录无效。'
  read_tty value "Mixed 端口 [$MIXED_PORT]："; [[ -n $value ]] && MIXED_PORT=$value; port_ok "$MIXED_PORT" || die 'Mixed 端口无效。'
  read_tty value "控制 API 地址 [$CONTROLLER_HOST]："; [[ -n $value ]] && CONTROLLER_HOST=$value
  read_tty value "控制 API 端口 [$CONTROLLER_PORT]："; [[ -n $value ]] && CONTROLLER_PORT=$value; port_ok "$CONTROLLER_PORT" || die '控制端口无效。'
  [[ $MIXED_PORT != "$CONTROLLER_PORT" ]] || die 'Mixed 端口与控制 API 端口不能相同。'
  read_tty value 'API Secret（留空则保留或生成）：' 1; [[ -n $value ]] && SECRET=$value; [[ -n $SECRET ]] || SECRET=$(secret_gen)
  CONFIG_FILE=${CONFIG_DIR%/}/config.yaml
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR" || true
  [[ ! -f $CONFIG_FILE && -f $old_config && $old_config != "$CONFIG_FILE" ]] && cp -a "$old_config" "$CONFIG_FILE"
  if [[ -f $CONFIG_FILE ]]; then
    cp -a "$CONFIG_FILE" "$CONFIG_FILE.bak.$(date +%Y%m%d-%H%M%S)"
    yaml_set "$CONFIG_FILE" mixed-port "$MIXED_PORT"
    yaml_set "$CONFIG_FILE" external-controller "$(yaml_q "$CONTROLLER_HOST:$CONTROLLER_PORT")"
    yaml_set "$CONFIG_FILE" secret "$(yaml_q "$SECRET")"
    grep -q '^external-controller-cors:' "$CONFIG_FILE" || printf "\nexternal-controller-cors:\n  allow-origins:\n    - '*'\n  allow-private-network: true\n" >> "$CONFIG_FILE"
  else
    cat > "$CONFIG_FILE" <<CFG
mixed-port: $MIXED_PORT
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
ipv6: true
external-controller: $(yaml_q "$CONTROLLER_HOST:$CONTROLLER_PORT")
secret: $(yaml_q "$SECRET")
external-controller-cors:
  allow-origins:
    - '*'
  allow-private-network: true
proxies: []
proxy-groups: []
rules:
  - MATCH,DIRECT
CFG
  fi
  chmod 600 "$CONFIG_FILE"
}

test_cfg(){ "$1" -t -d "$CONFIG_DIR" -f "$CONFIG_FILE"; }
write_service(){ cat > "$SERVICE" <<UNIT
[Unit]
Description=Mihomo Proxy Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=$CONFIG_DIR
ExecStart=$BIN -d $CONFIG_DIR -f $CONFIG_FILE
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
UMask=0027

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload; }
verify_after_start(){
  sleep 1
  show_summary
  if [[ $SERVICE_STATE == running ]]; then return 0; fi
  if [[ $SERVICE_STATE == degraded ]]; then warn 'Mihomo 主进程仍在运行，但监听检查发现异常。请修改冲突端口后重启。'; return 1; fi
  return 1
}
install_action(){
  root; systemd; load_state; prompt_download; save_state; download; prompt_settings; test_cfg "$TMP/mihomo" || die '配置检查失败。'
  local rollback=
  [[ -x $BIN ]] && rollback=$BIN.rollback && cp -a "$BIN" "$rollback"
  install -m 0755 "$TMP/mihomo" "$BIN"
  write_service
  systemctl enable mihomo >/dev/null
  if systemctl restart mihomo; then
    save_state
    if verify_after_start; then [[ -n $rollback ]] && rm -f "$rollback"; ok 'Mihomo 已安装并设置为开机自启。'; return; fi
    warn 'Mihomo 已安装，但当前运行异常。'
    return 1
  fi
  [[ -n $rollback ]] && mv -f "$rollback" "$BIN"
  systemctl restart mihomo >/dev/null 2>&1 || true
  die '启动失败，已尝试回滚。'
}
upgrade_action(){
  root; systemd; load_state; [[ -x $BIN ]] || die '尚未安装。'; download; test_cfg "$TMP/mihomo" || die '新版本不兼容当前配置。'
  cp -a "$BIN" "$BIN.rollback"
  install -m 0755 "$TMP/mihomo" "$BIN"
  if systemctl restart mihomo; then
    if verify_after_start; then rm -f "$BIN.rollback"; ok '升级完成。'; return; fi
    warn 'Mihomo 二进制已升级，但当前运行异常。'
    return 1
  fi
  mv -f "$BIN.rollback" "$BIN"
  systemctl restart mihomo || true
  die '升级失败，已回滚。'
}
download_action(){ root; load_state; prompt_download; save_state; ok 'GitHub 下载方式已保存。'; }
configure_action(){
  root; systemd; load_state; [[ -x $BIN ]] || die '尚未安装。'; prompt_download; prompt_settings; test_cfg "$BIN" || die '配置检查失败，请从备份恢复。'; write_service; systemctl enable mihomo >/dev/null; save_state
  systemctl restart mihomo
  if verify_after_start; then ok '设置已更新。'; else warn '设置已保存，但 Mihomo 当前运行异常。'; return 1; fi
}
service_control_action(){
  local action=$1
  root; systemd; load_state
  systemctl "$action" mihomo
  if [[ $action == stop ]]; then show_summary; return; fi
  if verify_after_start; then ok "服务已${action/start/启动}"; else return 1; fi
}
status_action(){ show_summary; [[ -f $SERVICE ]] && systemctl status mihomo -l --no-pager || true; }
uninstall_action(){
  root; systemd; load_state
  local yes=0 purge=0
  shift || true
  while (($#)); do case $1 in -y|--yes) yes=1;; --purge) purge=1;; *) die "未知参数：$1";; esac; shift; done
  ((yes)) || confirm '确定卸载 Mihomo 吗？' || return
  systemctl disable --now mihomo >/dev/null 2>&1 || true
  rm -f "$SERVICE" "$BIN" "$STATE"
  systemctl daemon-reload
  if ((purge)); then case $CONFIG_DIR in /|/etc|/usr|/var|/home|/root|/opt|/srv) warn "拒绝删除危险目录：$CONFIG_DIR";; *) rm -rf -- "$CONFIG_DIR";; esac; fi
  ok 'Mihomo 已卸载。'
}

help(){ cat <<HELP
mhm v$VERSION - Mihomo Linux 管理脚本

sudo mhm                     互动菜单
sudo mhm install             安装或重新安装
sudo mhm upgrade             升级 Mihomo
sudo mhm configure           修改全部设置
sudo mhm download            设置 GitHub 下载方式
sudo mhm proxy               同上（兼容旧命令）
sudo mhm start|stop|restart
sudo mhm status              查看安装、运行、端口和配置信息
sudo mhm logs                查看实时日志
sudo mhm test                检查配置
sudo mhm uninstall [--yes] [--purge]

临时环境变量：
MIHOMO_VERSION=v1.19.29
MIHOMO_GITHUB_MIRROR=https://ghproxy.com
MIHOMO_DOWNLOAD_PROXY=socks5h://127.0.0.1:12222
MIHOMO_GITHUB_PROXY=...       兼容旧变量；SOCKS 地址自动作为网络代理
HELP
}
menu(){
  while true; do
    printf '\n%bmhm v%s%b\n' "$CYAN" "$VERSION" "$R"
    show_summary
    printf '\n1. 安装/重装\n2. 升级\n3. 修改全部设置\n4. 设置 GitHub 下载方式\n5. 启动\n6. 停止\n7. 重启\n8. 详细状态\n9. 日志\n10. 检查配置\n11. 卸载\n0. 退出\n'
    local choice=
    read_tty choice '请选择 [0-11]：'
    case $choice in
      1) install_action || true;;
      2) upgrade_action || true;;
      3) configure_action || true;;
      4) download_action;;
      5) service_control_action start || true;;
      6) service_control_action stop || true;;
      7) service_control_action restart || true;;
      8) status_action;;
      9) journalctl -u mihomo -n100 -f -o cat;;
      10) load_state; [[ -x $BIN ]] || die '尚未安装。'; test_cfg "$BIN";;
      11) uninstall_action uninstall;;
      0) exit;;
      *) warn '无效选项。';;
    esac
  done
}

cmd=${1:-menu}
case $cmd in
  menu) menu;;
  install) install_action;;
  upgrade|update) upgrade_action;;
  configure|config) configure_action;;
  download|proxy|github-proxy) download_action;;
  start|stop|restart) service_control_action "$cmd";;
  status) status_action;;
  logs|log) journalctl -u mihomo -n100 -f -o cat;;
  test|check) load_state; [[ -x $BIN ]] || die '尚未安装。'; test_cfg "$BIN";;
  uninstall|remove) uninstall_action "$@";;
  -h|--help|help) help;;
  -v|--version|version) echo "mhm $VERSION";;
  *) die "未知命令：$cmd";;
esac
